    duration : -2ms <= Camera4_JITTER <= 2ms;
    continuous process Camera4_JITTER with normal(0s, 1ms);
    
    duration : 1ms <= Camera4_EXECUTION <= 9ms;
    continuous process Camera4_EXECUTION with normal(5ms, 2ms);
        

    
    duration : 0ms <= Camera5_PHASE <= 35ms;
    continuous process Camera5_PHASE with uniform;

    duration : -2ms <= Camera5_JITTER <= 2ms;
    continuous process Camera5_JITTER with normal(0s, 1ms);
    
    duration : 1ms <= Camera5_EXECUTION <= 9ms;
    continuous process Camera5_EXECUTION with normal(5ms, 2ms);
        

    
    duration : 0ms <= Camera6_PHASE <= 35ms;
    continuous process Camera6_PHASE with uniform;

    duration : -2ms <= Camera6_JITTER <= 2ms;
    continuous process Camera6_JITTER with normal(0s, 1ms);
    
    duration : 1ms <= Camera6_EXECUTION <= 9ms;
    continuous process Camera6_EXECUTION with normal(5ms, 2ms);
        

    
    duration : 0ms <= Camera7_PHASE <= 35ms;
