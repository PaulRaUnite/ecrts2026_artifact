    duration : -2ms <= Camera7_JITTER <= 2ms;
    continuous process Camera7_JITTER with normal(0s, 1ms);
    
    duration : 1ms <= Camera7_EXECUTION <= 9ms;
    continuous process Camera7_EXECUTION with normal(5ms, 2ms);
        

    
    duration : 0ms <= LiDAR_PHASE <= 102ms;
    continuous process LiDAR_PHASE with uniform;

    duration : -2ms <= LiDAR_JITTER <= 2ms;
    continuous process LiDAR_JITTER with normal(0s, 1ms);
    
    duration : 0ms <= LiDAR_EXECUTION <= 20ms;
    continuous process LiDAR_EXECUTION with normal(10ms, 5ms);
        

    
    duration : 0ms <= Radar_PHASE <= 102ms;
