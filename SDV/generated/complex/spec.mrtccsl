assume {
    
    
    duration : 0ms <= GPS_PHASE <= 102ms;
    continuous process GPS_PHASE with uniform;

    duration : -2ms <= GPS_JITTER <= 2ms;
    continuous process GPS_JITTER with normal(0s, 1ms);
    
    duration : 0ms <= GPS_EXECUTION <= 4ms;
    continuous process GPS_EXECUTION with normal(2ms, 1ms);
        

    
    duration : 0ms <= Inertial_PHASE <= 17ms;
    continuous process Inertial_PHASE with uniform;

    duration : -2ms <= Inertial_JITTER <= 2ms;
    continuous process Inertial_JITTER with normal(0s, 1ms);
    
    duration : 0ms <= Inertial_EXECUTION <= 4ms;
    continuous process Inertial_EXECUTION with normal(2ms, 1ms);
        

    
    duration : 0ms <= SteeringWheelPosition_PHASE <= 22ms;
    continuous process SteeringWheelPosition_PHASE with uniform;

    duration : -2ms <= SteeringWheelPosition_JITTER <= 2ms;
    continuous process SteeringWheelPosition_JITTER with normal(0s, 1ms);
    
    duration : 0ms <= SteeringWheelPosition_EXECUTION <= 4ms;
    continuous process SteeringWheelPosition_EXECUTION with normal(2ms, 1ms);
        

    
    duration : 0ms <= BrakePedalPosition_PHASE <= 22ms;
