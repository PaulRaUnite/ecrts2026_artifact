    duration : -2ms <= Camera1_JITTER <= 2ms;
    continuous process Camera1_JITTER with normal(0s, 1ms);
    
    duration : 1ms <= Camera1_EXECUTION <= 9ms;
    continuous process Camera1_EXECUTION with normal(5ms, 2ms);
        

    
    duration : 0ms <= Camera2_PHASE <= 35ms;
