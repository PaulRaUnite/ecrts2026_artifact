    duration : 0ms <= AccelerationPedalPosition_EXECUTION <= 4ms;
    continuous process AccelerationPedalPosition_EXECUTION with normal(2ms, 1ms);
        

    
    duration : 0ms <= Camera1_PHASE <= 35ms;
