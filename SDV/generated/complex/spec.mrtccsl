    continuous process Wheel4Speed_JITTER with normal(0s, 1ms);
    
    duration : 3ms <= Wheel4Speed_EXECUTION <= 7ms;
    continuous process Wheel4Speed_EXECUTION with normal(5ms, 1ms);
        

    
    
    duration : 6ms <= Braking_EXECUTION <= 14ms;
    continuous process Braking_EXECUTION with normal(10ms, 2ms);
        

    
    
    duration : 0ms <= CollisionAlert_EXECUTION <= 4ms;
    continuous process CollisionAlert_EXECUTION with normal(2ms, 1ms);
        

    
    
    duration : 0ms <= PassingVehicleIndicator_EXECUTION <= 4ms;
    continuous process PassingVehicleIndicator_EXECUTION with normal(2ms, 1ms);
        

    
    duration : 0ms <= NavigationHint_PHASE <= 42ms;
    continuous process NavigationHint_PHASE with uniform;

    duration : -2ms <= NavigationHint_JITTER <= 2ms;
    continuous process NavigationHint_JITTER with normal(0s, 1ms);
    
