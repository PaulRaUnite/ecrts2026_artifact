    duration : -2ms <= Wheel2Speed_JITTER <= 2ms;
    continuous process Wheel2Speed_JITTER with normal(0s, 1ms);
    
    duration : 3ms <= Wheel2Speed_EXECUTION <= 7ms;
    continuous process Wheel2Speed_EXECUTION with normal(5ms, 1ms);
        

    
