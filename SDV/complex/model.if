process NavigationHint(1);
    var x clock;
    var e clock;
    var nbData boolean;
    state start #start ;
        task nbData := false;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 38;
            set x := 0;
            nextstate jitter;
        input NavigationHint();
            task nbData := true;
            nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4;
            set e := 0;
            nextstate preprocessing;
        input NavigationHint();
            task nbData := true;
            nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData = false;
            informal "NavigationHint_USELESS_ACT";
            nextstate processing;
        deadline eager;
        provided nbData = true;
            informal "NavigationHint_USEFUL_ACT";
            task nbData := false;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 0 and e <= 4;
            informal "NavigationHint_FINISH";
            reset e;
            nextstate wait;
        input NavigationHint();
            task nbData := true;
            nextstate processing;
    endstate;
    state wait;
        when x = 40;
            set x := 0;
            nextstate jitter;
        input NavigationHint();
            task nbData := true;
            nextstate wait;
    endstate;
endprocess;
