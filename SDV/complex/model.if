process Braking(1);
    var e clock;
    state wait #start ;
        input Braking();
            informal "Braking_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 6 and e <= 14;
            informal "Braking_FINISH";
            reset e;
            nextstate wait;
    endstate;
endprocess;
process CollisionAlert(1);
    var e clock;
    state wait #start ;
        input CollisionAlert();
            informal "CollisionAlert_START";
