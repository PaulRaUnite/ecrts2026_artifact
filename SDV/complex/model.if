process GPS(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 98;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4 ;
            informal "GPS_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 0 and e <= 4;
            informal "GPS_FINISH";
            reset e;
			output GPS() to {Fusion_Positioning}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 100;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
process Inertial(1);
    var x clock;
    var e clock;
    state start #start ;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 13;
            set x := 0;
            nextstate jitter;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4 ;
            informal "Inertial_START";
            set e := 0;
            nextstate exec;
    endstate;
    state exec;
        deadline delayable;
        when e >= 0 and e <= 4;
            informal "Inertial_FINISH";
            reset e;
			output Inertial() to {Fusion_Positioning}0;
            nextstate wait;
    endstate;
    state wait;
        when x = 15;
            set x := 0;
            nextstate jitter;
    endstate;
endprocess;
