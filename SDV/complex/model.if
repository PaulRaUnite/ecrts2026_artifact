process Fusion_Positioning(1);
	var e clock;
    state wait #start ;
        input Inertial();
            informal "Fusion_Positioning_START";
            set e := 0;
            nextstate processing;
    endstate;
    state processing;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Fusion_Positioning_FINISH";
			output Position() to {Assistance_Navigation}0;
            reset e;
            nextstate wait;
    endstate;
endprocess;
process Fusion_Speed(1);
	var x clock;
    var e clock;
    var nbData boolean;
    state start #start ;
        task nbData := false;
        set x := 0;
        nextstate first;
    endstate;
    state first;
        deadline delayable;
        when x <= 23;
            set x := 0;
            nextstate jitter;
		input Wheel1Speed();
			task nbData := true;
			nextstate first;
		input Wheel2Speed();
			task nbData := true;
			nextstate first;
		input Wheel3Speed();
			task nbData := true;
			nextstate first;
		input Wheel4Speed();
			task nbData := true;
			nextstate first;
    endstate;
    state jitter;
        deadline delayable;
        when x <= 4;
            set e := 0;
            nextstate preprocessing;
		input Wheel1Speed();
			task nbData := true;
			nextstate jitter;
		input Wheel2Speed();
			task nbData := true;
			nextstate jitter;
		input Wheel3Speed();
			task nbData := true;
			nextstate jitter;
		input Wheel4Speed();
			task nbData := true;
			nextstate jitter;
    endstate;
    state preprocessing;
        deadline eager;
        provided nbData = false;
            informal "Fusion_Speed_USELESS_EXEC";
            nextstate processing1;
        deadline eager;
        provided nbData = true;
            informal "Fusion_Speed_USEFUL_EXEC";
            task nbData := false;
            nextstate processing2;
    endstate;
    state processing1;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Fusion_Speed_FINISH";
			output Speed() to {SemanticExtraction_Prediction}0;
			output Speed() to {CollisionDetection_TimeToCollision}0;
            reset e;
            nextstate wait;
		input Wheel1Speed();
			task nbData := true;
			nextstate processing1;
		input Wheel2Speed();
			task nbData := true;
			nextstate processing1;
		input Wheel3Speed();
			task nbData := true;
			nextstate processing1;
		input Wheel4Speed();
			task nbData := true;
			nextstate processing1;
    endstate;
    state processing2;
        deadline delayable;
        when e >= 1 and e <= 1;
            informal "Fusion_Speed_FINISH";
			output Speed() to {SemanticExtraction_Prediction}0;
			output Speed() to {CollisionDetection_TimeToCollision}0;
            reset e;
            nextstate wait;
		input Wheel1Speed();
			task nbData := true;
			nextstate processing2;
		input Wheel2Speed();
			task nbData := true;
			nextstate processing2;
		input Wheel3Speed();
			task nbData := true;
			nextstate processing2;
		input Wheel4Speed();
			task nbData := true;
			nextstate processing2;
    endstate;
    state wait;
        when x = 25;
            set x := 0;
            nextstate jitter;
