system simple;
type int = range 0 .. 255;
signal GPS();
signal Inertial();
signal Wheel1Speed();
signal Wheel2Speed();
signal Wheel3Speed();
signal Wheel4Speed();
signal Camera1();
signal Camera2();
signal Camera3();
signal Camera4();
signal Camera5();
signal Camera6();
signal Camera7();
signal LiDAR();
signal Radar();
signal CameraEnvironment();
signal LiDAREnvironment();
signal RadarEnvironment();
signal EnvironmentMap();
signal Lanes();
signal Signs();
signal Vehicles();
signal Pedestrians();
signal Cyclist();
signal SteeringWheelPosition();
signal BrakePedalPosition();
signal AccelerationPedalPosition();
signal Speed();
signal Trajectories();
signal TimeToCollision();
signal Position();
signal EgoTrajectory();
