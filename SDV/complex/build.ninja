rule simulation
    command = cd /home/ptokarie/code/mrtccsl/;eval $$(opam env); cd $$OLDPWD; OCAMLRUNPARAM=b  ccsl+ simulate $in -o ./ --traces=10 --steps=100000 --horizon=10000

rule reaction_time
    command = cd /home/ptokarie/code/mrtccsl/;eval $$(opam env); cd $$OLDPWD; OCAMLRUNPARAM=b  ccsl+ reaction -s earliest --scale=0.001 -c -w worst $in -l ./ -o ./

rule compile_image
    command = unset GTK_PATH; gnuplot -e "filename='$in'" template.gnu

rule convert_trace
    command = cd /home/ptokarie/code/mrtccsl/;eval $$(opam env); cd $$OLDPWD; OCAMLRUNPARAM=b  ccsl+ trace convert native csl --microstep=spec.mrtccsl --discretize=near --scale=0.001 $in -o $out

rule convert_svg_bob
    command = cd /home/ptokarie/code/mrtccsl/;eval $$(opam env); cd $$OLDPWD; OCAMLRUNPARAM=b  ccsl+ trace convert native svgbob --vertical --tasks=/home/ptokarie/code/hal4sdv/SoftwareDefinedVehicleModelingLanguage/workspace/generated/complex/tasks.csv $in -o $out

build 0.trace 1.trace 2.trace 3.trace 4.trace 5.trace 6.trace 7.trace 8.trace 9.trace : simulation spec.mrtccsl
build trace/t1.txt : convert_trace 0.trace | spec.mrtccsl
build trace/0.svgbob : convert_svg_bob 0.trace | /home/ptokarie/code/hal4sdv/SoftwareDefinedVehicleModelingLanguage/workspace/generated/complex/tasks.csv
